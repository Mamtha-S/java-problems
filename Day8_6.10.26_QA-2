**Majority Element** — Find element appearing > n/2 times
______________________________________________________________
class Solution {
    public int majorityElement(int[] nums) {
        int candidate = 0;
        int count = 0;

        for (int num : nums) {
            if (count == 0) {
                candidate = num;
            }

            count += (num == candidate) ? 1 : -1;
        }

        return candidate;
    }
}

Input: [2,2,1,1,1,2,2]

Output: 2
